#ifndef RGTC_H_
#define RGTC_H_

float decode_alpha_rgtc(uvec2 payload, int linear_pixel)
{
	float ep0 = float(int(payload.x & 0xffu)) / 255.0;
	float ep1 = float(((payload.x >> 8) & 0xffu)) / 255.0;
	bool range7 = ep0 > ep1;

	int bit_offset = 16 + linear_pixel * 3;
	uint bits;
	if (bit_offset <= 29)
		bits = bitfieldExtract(payload.x, bit_offset, 3);
	else if (bit_offset >= 32)
		bits = bitfieldExtract(payload.y, bit_offset - 32, 3);
	else
		bits = bitfieldExtract(payload.x, 31, 1) | ((payload.y & 3) << 1);

	float res;

	if (bits < 2)
		res = bits != 0 ? ep1 : ep0;
	else if (range7)
		res = mix(ep0, ep1, (1.0 / 7.0) * float(bits - 1));
	else if (bits > 5)
		res = float(bits & 1);
	else
		res = mix(ep0, ep1, (1.0 / 5.0) * float(bits - 1));

	return res;
}

float decode_alpha_rgtc_snorm(uvec2 payload, int linear_pixel)
{
   float ep0 = max(float(bitfieldExtract(int(payload.x), 0, 8)) / 127.0, -1.0);
   float ep1 = max(float(bitfieldExtract(int(payload.x), 8, 8)) / 127.0, -1.0);
   bool range7 = ep0 > ep1;
   int bit_offset = 16 + linear_pixel * 3;
   uint bits = bit_offset <= 29 ? bitfieldExtract(payload.x, bit_offset, 3) :
               bit_offset >= 32 ? bitfieldExtract(payload.y, bit_offset - 32, 3) :
               bitfieldExtract(payload.x, 31, 1) | ((payload.y & 3) << 1);
   if (bits < 2)
      return bits != 0 ? ep1 : ep0;
   if (range7)
      return mix(ep0, ep1, (1.0 / 7.0) * float(bits - 1));
   if (bits > 5)
      return bits == 6 ? -1.0 : 1.0;
   return mix(ep0, ep1, (1.0 / 5.0) * float(bits - 1));
}

#endif


#define VK_FORMAT_BC4_UNORM_BLOCK 139
#define VK_FORMAT_BC4_SNORM_BLOCK 140
#define VK_FORMAT_BC5_UNORM_BLOCK 141
#define VK_FORMAT_BC5_SNORM_BLOCK 142




void main()
{
    int format = registers.format;
    bool bc5 = (format == VK_FORMAT_BC5_UNORM_BLOCK || format == VK_FORMAT_BC5_SNORM_BLOCK);
#ifdef PANVK_BC_FS
    /* One invocation per texel of the render area starting at (x0, y0); the
     * layer comes from the layered rect draw. */
    int x = int(gl_FragCoord.x) - registers.x0;
    int y = int(gl_FragCoord.y) - registers.y0;
    int z = gl_Layer;
#else
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);
    int z = int(gl_GlobalInvocationID.z);
#endif

    ivec2 pixel_coord = ivec2(x, y) % 4;
    int linear_pixel = 4 * pixel_coord.y + pixel_coord.x;
    InBuf ibuf = InBuf(registers.src);
    OutBuf obuf = OutBuf(registers.dst);
    uint in_word = (uint(z) * registers.src_slice_B + uint(y / 4) * registers.src_row_B) / 4u;
    uint out_word = (uint(z) * registers.dst_slice_B + uint(y) * registers.dst_row_B) / 4u;

    bool is_snorm = (format == VK_FORMAT_BC4_SNORM_BLOCK || format == VK_FORMAT_BC5_SNORM_BLOCK);
    uint bw = bc5 ? 4u : 2u;
    uint w = in_word + uint(x / 4) * bw;
#ifdef PANVK_BC_FS
    uvec4 payload = uvec4(ibuf.data[w], ibuf.data[w + 1u],
                          bc5 ? ibuf.data[w + 2u] : 0u,
                          bc5 ? ibuf.data[w + 3u] : 0u);
#else
    uint block_idx = (gl_LocalInvocationID.y / 4u) * 4u +
                     gl_LocalInvocationID.x / 4u;
    if ((gl_LocalInvocationID.x & 3u) == 0u &&
        (gl_LocalInvocationID.y & 3u) == 0u &&
        x < registers.width && y < registers.height) {
        bc_block_payload[block_idx] =
           uvec4(ibuf.data[w], ibuf.data[w + 1u],
                 bc5 ? ibuf.data[w + 2u] : 0u,
                 bc5 ? ibuf.data[w + 3u] : 0u);
    }
    barrier();
    if (x >= registers.width || y >= registers.height ||
        z >= registers.depth)
        return;
    uvec4 payload = bc_block_payload[block_idx];
#endif

#ifdef PANVK_BC_FS
    vec2 rg = vec2(decode_alpha_rgtc(payload.xy, linear_pixel), 0.0);
    if (is_snorm)
        rg.x = decode_alpha_rgtc_snorm(payload.xy, linear_pixel);
    if (bc5) {
        rg.y = is_snorm ? decode_alpha_rgtc_snorm(payload.zw, linear_pixel) :
                          decode_alpha_rgtc(payload.zw, linear_pixel);
    }
    o_color = vec4(rg, 0.0, 1.0);
#else
    if (bc5) {
        if ((x & 1) != 0)
            return;
        vec2 c0 = vec2(
            is_snorm ? decode_alpha_rgtc_snorm(payload.xy, linear_pixel) :
                       decode_alpha_rgtc(payload.xy, linear_pixel),
            is_snorm ? decode_alpha_rgtc_snorm(payload.zw, linear_pixel) :
                       decode_alpha_rgtc(payload.zw, linear_pixel));
        vec2 c1 = vec2(
            is_snorm ? decode_alpha_rgtc_snorm(payload.xy, linear_pixel + 1) :
                       decode_alpha_rgtc(payload.xy, linear_pixel + 1),
            is_snorm ? decode_alpha_rgtc_snorm(payload.zw, linear_pixel + 1) :
                       decode_alpha_rgtc(payload.zw, linear_pixel + 1));
        vec4 values = vec4(c0, c1);
        obuf.data[out_word + uint(x) / 2u] =
            is_snorm ? packSnorm4x8(clamp(values, -1.0, 1.0)) :
                       packUnorm4x8(clamp(values, 0.0, 1.0));
    } else {
        if ((x & 3) != 0)
            return;
        vec4 values;
        for (int i = 0; i < 4; i++) {
            float value = is_snorm ?
                decode_alpha_rgtc_snorm(payload.xy, linear_pixel + i) :
                decode_alpha_rgtc(payload.xy, linear_pixel + i);
            values[i] = is_snorm ? clamp(value, -1.0, 1.0) :
                                   clamp(value, 0.0, 1.0);
        }
        obuf.data[out_word + uint(x) / 4u] =
            is_snorm ? packSnorm4x8(values) : packUnorm4x8(values);
    }
#endif
}
