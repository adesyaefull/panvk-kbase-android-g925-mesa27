#version 450
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require

#ifdef PANVK_BC_FS
/* Fragment variant (-DPANVK_BC_FS -S frag): decode into a colour attachment. */
layout(location = 0) out vec4 o_color;
#else
layout(local_size_x = 16, local_size_y = 4, local_size_z = 1) in;
#endif

layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer InBuf {
    uint data[];
};

layout(buffer_reference, std430, buffer_reference_align = 4) writeonly buffer OutBuf {
    uint data[];
};

#ifndef PANVK_BC_FS
shared uvec4 bc_block_payload[4];
#endif

layout(push_constant) uniform Registers
{
    uvec2 src;
    uvec2 dst;
    uint src_row_B;
    uint src_slice_B;
    uint dst_row_B;
    uint dst_slice_B;
    int width;
    int height;
    int depth;
    int format;
    int x0;
    int y0;
} registers;

